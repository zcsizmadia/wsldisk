---
# Notes on the disabled checks (they cannot live inside the block scalar below):
#   clang-diagnostic-unused-command-line-argument -- cl and clang-cl consume
#     different MSVC flags; compiler diagnostics are the build's job, not the
#     linter's.
#   performance-enum-size -- ErrorCode deliberately uses int, because its values
#     are the documented process exit codes.
#   misc-include-cleaner -- too noisy against <windows.h>, which pulls in
#     hundreds of transitive headers.
#   portability-template-virtual-member-function -- fires inside MSVC's own
#     <fstream> the moment anything holds a std::ofstream. The finding is about
#     the standard library's internals, not ours, and there is nothing in this
#     repository to change in response to it.
#   cppcoreguidelines-pro-type-union-access -- the Virtual Disk Service passes
#     every parameter and result through a versioned union (OPEN_VIRTUAL_DISK_
#     PARAMETERS, GET_VIRTUAL_DISK_INFO, ...). Reading those members is the API,
#     not a design choice, and there is no variant to reach for.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -clang-diagnostic-unused-command-line-argument,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-type-vararg,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -portability-template-virtual-member-function,
  -readability-identifier-length,
  -readability-magic-numbers

WarningsAsErrors: '*'
HeaderFilterRegex: '.*[/\\]src[/\\].*'
FormatStyle: file

CheckOptions:
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case
  - key:   readability-identifier-naming.ClassCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key:   readability-identifier-naming.FunctionCase
    value: lower_case
  - key:   readability-identifier-naming.VariableCase
    value: lower_case
  - key:   readability-identifier-naming.ParameterCase
    value: lower_case
  - key:   readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key:   readability-identifier-naming.ConstantCase
    value: lower_case
  - key:   readability-identifier-naming.GlobalConstantCase
    value: lower_case
  - key:   readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key:   readability-function-cognitive-complexity.Threshold
    value: '25'
